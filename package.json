{
  "name": "statshub-database",
  "version": "1.0.0",
  "private": true,
  "description": "Esquema y migraciones PostgreSQL de StatsHub Deportivo",
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:baseline": "node scripts/migrate.js up 1763450000000_linea-base --fake",
    "migrate:create": "node scripts/migrate.js create",
    "seed": "node scripts/seed.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1"
  }
}

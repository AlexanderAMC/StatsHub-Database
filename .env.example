DB_HOST=localhost
DB_PORT=5432
DB_NAME=statshub_deportivo
DB_USER=postgres
DB_PASSWORD=<tu_contraseña>

# Amazon RDS: exige conexión cifrada. Certificado: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# DB_SSL=true
# DB_SSL_CA=/var/www/statshub/rds-global-bundle.pem

# Alternativa: una sola URL de conexión (tiene prioridad sobre DB_*)
# DATABASE_URL=postgres://usuario:contraseña@localhost:5432/statshub_deportivo
